#!/usr/bin/env bash
# Pre-commit → full hard gates (migrations, systemConfig, catalog, GUI, …).
# Auto-wired by scripts/install-git-hooks.sh (also self-heals via run-gates).
# Do not require a manual `git config core.hooksPath` — the installer does that.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec bash "$ROOT/tests/run-gates.sh"
