# Migrated from ui/gui/export-options.sh — body via fromJSON (Nix-safe).
# Dollar signs are \u0024 so Nix does not interpolate bash ${...}.
{ pkgs, getModuleApi ? null, ... }:
pkgs.writeText "export-options.sh" (builtins.fromJSON ''
"#!/usr/bin/env bash\n# Export install options from setup-options.sh (+ descriptions) for the GUI wizard.\n# Plain text sections \u2014 single source of truth stays in shell prompts.\n#\n# Usage: export-options.sh\n# Stdout sections consumed by install_wizard.py\n\nset -euo pipefail\n\nGUI_DIR=\"\u0024(cd \"\u0024(dirname \"\u0024{BASH_SOURCE[0]}\")\" && pwd)\"\nPROMPTS_DIR=\"\u0024(cd \"\u0024GUI_DIR/../prompts\" && pwd)\"\n\n# shellcheck source=../prompts/setup-options.sh\nsource \"\u0024PROMPTS_DIR/setup-options.sh\"\n# shellcheck source=../prompts/descriptions/setup-descriptions.sh\nsource \"\u0024PROMPTS_DIR/descriptions/setup-descriptions.sh\"\n\n# Device targets SSOT = host-blueprints deviceTarget (re-load if empty)\nif [[ \u0024{#DEVICE_TARGETS[@]} -eq 0 ]]; then\n  if declare -F load_discovered_device_targets >/dev/null 2>&1; then\n    load_discovered_device_targets\n  elif [[ -f \"\u0024{SCRIPT_ROOT:-}/ui/gui/device_discover.py\" ]]; then\n    eval \"\u0024(python3 \"\u0024SCRIPT_ROOT/ui/gui/device_discover.py\" export-bash)\"\n  elif [[ -f \"\u0024GUI_DIR/device_discover.py\" ]]; then\n    eval \"\u0024(python3 \"\u0024GUI_DIR/device_discover.py\" export-bash)\"\n  fi\nfi\nif declare -p DEVICE_TARGET_DESCRIPTIONS >/dev/null 2>&1; then\n  for _k in \"\u0024{!DEVICE_TARGET_DESCRIPTIONS[@]}\"; do\n    SETUP_DESCRIPTIONS[\"\u0024_k\"]=\"\u0024{DEVICE_TARGET_DESCRIPTIONS[\u0024_k]}\"\n  done\nfi\n\nemit_list() {\n  local section=\"\u00241\"\n  shift\n  printf '[%s]\\n' \"\u0024section\"\n  local item\n  for item in \"\u0024@\"; do\n    printf '%s\\n' \"\u0024item\"\n  done\n  printf '\\n'\n}\n\nemit_assoc() {\n  local section=\"\u00241\"\n  local -n ref=\"\u00242\"\n  printf '[%s]\\n' \"\u0024section\"\n  local key\n  for key in \"\u0024{!ref[@]}\"; do\n    printf '%s=%s\\n' \"\u0024key\" \"\u0024{ref[\u0024key]}\"\n  done\n  printf '\\n'\n}\n\nemit_list INSTALL_BASES \"\u0024{INSTALL_BASES[@]}\"\nemit_list INSTALL_STARTERS \"\u0024{INSTALL_STARTERS[@]}\"\nemit_list DEVICE_TARGETS \"\u0024{DEVICE_TARGETS[@]}\"\nemit_assoc DEVICE_BLUEPRINT_MAP DEVICE_BLUEPRINT_MAP\nemit_list FEATURE_GROUPS \"\u0024{FEATURE_GROUPS[@]}\"\nemit_list INSTALL_TYPE_OPTIONS \"\u0024{INSTALL_TYPE_OPTIONS[@]}\"\nemit_list ADVANCED_OPTIONS \"\u0024{ADVANCED_OPTIONS[@]}\"\n\n# Desktop envs from FEATURE_GROUPS \"Desktop Environment:...\" + None\nprintf '[DESKTOP_ENVS]\\n'\nfor group in \"\u0024{FEATURE_GROUPS[@]}\"; do\n  if [[ \"\u0024{group%%:*}\" == \"Desktop Environment\" ]]; then\n    IFS='|' read -ra envs <<< \"\u0024{group#*:}\"\n    for env in \"\u0024{envs[@]}\"; do\n      printf '%s\\n' \"\u0024env\"\n    done\n  fi\ndone\nprintf 'none\\n'\nprintf '\\n'\n\nemit_assoc FEATURE_CONFLICTS FEATURE_CONFLICTS\nemit_assoc FEATURE_DEPENDENCIES FEATURE_DEPENDENCIES\nemit_assoc INSTALL_BASE_DEFAULT_PACKAGES INSTALL_BASE_DEFAULT_PACKAGES\nemit_assoc DESCRIPTIONS SETUP_DESCRIPTIONS\n\nemit_list DESKTOP_BROWSERS \"\u0024{DESKTOP_BROWSERS[@]}\"\nprintf '[DESKTOP_BROWSER_DEFAULT]\\n%s\\n\\n' \"\u0024{DESKTOP_BROWSER_DEFAULT:-firefox}\"\n\n# FEATURE_SYSTEM_TYPES already filled by setup-options.sh (packages API catalog)\nemit_assoc FEATURE_SYSTEM_TYPES FEATURE_SYSTEM_TYPES\n"
'')
