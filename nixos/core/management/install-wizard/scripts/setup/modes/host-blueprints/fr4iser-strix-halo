{
  #
  # AMD Strix Halo AI workstation — host blueprint stub
  #
  # Docker / AI stacks: add later when ready.
  #
  # Opt into install "device target" discovery (no wiring elsewhere):
  deviceTarget = {
    enable = true;
    label = "Strix Halo";
    description = "AMD Strix Halo AI workstation (hardware). Docker/AI stacks TBD — stub for now.";
    match = {
      arch = [ "x86_64" ];
      lspci = [
        "Strix Halo"
        "Radeon 8050S"
        "Radeon 8060S"
      ];
      lscpu = [ "Strix Halo" ];
    };
  };

  systemType = "desktop";
  hostName = "strix-halo";
  system = {
    channel = "stable";
    platform = "x86_64-linux";
    bootloader = "systemd-boot";
  };

  packageModules = [
    # "docker"
    # "python-dev"
    # "system-dev"
  ];

  users = {
    "Jarvis" = {
      role = "admin";
      defaultShell = "zsh";
      autoLogin = false;
    };
  };

  desktop = {
    enable = true;
    environment = "plasma";
    display = {
      manager = "sddm";
      server = "wayland";
      session = "plasma";
    };
    theme = {
      dark = true;
    };
    audio = "pipewire";
  };

  hardware = {
    cpu = "amd";
    gpu = "amd";
    ram = {
      sizeGB = 64;
    };
  };

  allowUnfree = true;
  buildLogLevel = "minimal";

  features = {
    system-logger = false;
    system-checks = true;
    system-updater = true;
    ssh-client-manager = true;
    ssh-server-manager = true;
    bootentry-manager = true;
    homelab-manager = false;  # enable when docker stacks ready
    vm-manager = false;
    ai-workspace = true;
  };

  sudo = {
    requirePassword = false;
    timeout = 15;
  };
  enableFirewall = true;

  timeZone = "Europe/Berlin";
  locales = [ "en_US.UTF-8" ];
  keyboardLayout = "de";
  keyboardOptions = "eurosign";

  overrides = {
    enableSSH = null;
  };

  email = "example@example.com";
  domain = "example.com";
  certEmail = "example@example.com";
}
