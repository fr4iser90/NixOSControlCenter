{
  #
  # System Type & Profile — AMD Strix Halo AI workstation (stub)
  # Docker / AI stacks: fill in later when host setup is ready.
  #
  systemType = "desktop";
  hostName = "strix-halo";
  system = {
    channel = "stable";
    bootloader = "systemd-boot";
  };

  #
  # Package Modules — empty for now; add docker / AI sets later
  #
  packageModules = [
    # "docker"
    # "python-dev"
    # "system-dev"
  ];

  #
  # User Management
  #
  users = {
    "admin" = {
      role = "admin";
      defaultShell = "zsh";
      autoLogin = false;
    };
  };

  #
  # Desktop Environment
  #
  desktop = {
    enable = true;
    environment = "plasma";
    display = {
      manager = "sddm";
      server = "wayland";
      session = "plasma";
    };
    theme = {
      dark = true;
    };
    audio = "pipewire";
  };

  #
  # Hardware Configuration — Strix Halo (AMD APU)
  #
  hardware = {
    cpu = "amd";
    gpu = "amd";
    ram = {
      sizeGB = 64;
    };
  };

  #
  # Nix Configuration
  #
  allowUnfree = true;
  buildLogLevel = "minimal";

  #
  # Features — AI workspace on; Homelab/Docker stacks TBD
  #
  features = {
    system-logger = false;
    system-checks = true;
    system-updater = true;
    ssh-client-manager = true;
    ssh-server-manager = true;
    bootentry-manager = true;
    homelab-manager = false;  # enable when docker stacks ready
    vm-manager = false;
    ai-workspace = true;
  };

  #
  # Security Settings
  #
  sudo = {
    requirePassword = false;
    timeout = 15;
  };
  enableFirewall = true;

  #
  # Localization
  #
  timeZone = "Europe/Berlin";
  locales = [ "en_US.UTF-8" ];
  keyboardLayout = "de";
  keyboardOptions = "eurosign";

  #
  # Profile Overrides
  #
  overrides = {
    enableSSH = null;
  };

  #
  # Hosting Configuration (placeholder)
  #
  email = "example@example.com";
  domain = "example.com";
  certEmail = "example@example.com";
}
