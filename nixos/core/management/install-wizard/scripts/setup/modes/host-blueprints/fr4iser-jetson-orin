{
  #
  # NVIDIA Jetson Orin Nano (aarch64) — host blueprint stub
  #
  # NOTE: flake reads system.platform (prebuild syncs like CPU/GPU).
  # Jetpack modules are still a separate follow-up for full Orin deploy.
  #
  # Opt into install "device target" discovery (no wiring elsewhere):
  deviceTarget = {
    enable = true;
    label = "Jetson Orin Nano";
    description = "NVIDIA Jetson Orin Nano (aarch64 / jetpack). Platform via system.platform; jetpack input still TBD.";
    match = {
      arch = [ "aarch64" "arm64" ];
      filesAny = [ "/etc/nv_tegra_release" ];
      model = [ "orin" "jetson" ];
      compatible = [ "tegra" "orin" "jetson" ];
      textAny = [ "orin" "tegra" "jetson" "nvidia-jetpack" ];
    };
  };

  systemType = "server";
  hostName = "jetson-orin";
  system = {
    channel = "stable";
    platform = "aarch64-linux";
    bootloader = "systemd-boot";
  };

  packageModules = [
    # docker / AI stacks — align with draft later
  ];

  users = {
    "fr4iser" = {
      role = "admin";
      defaultShell = "zsh";
      autoLogin = false;
    };
  };

  desktop = {
    enable = false;
  };

  hardware = {
    cpu = "none";  # aarch64 / tegra — not intel/amd enums
    gpu = "nvidia";
    ram = {
      sizeGB = 8;
    };
  };

  allowUnfree = true;
  buildLogLevel = "minimal";

  features = {
    system-logger = false;
    system-checks = true;
    system-updater = true;
    ssh-manager = true; # server; set client.enable = true in module config for outbound
    bootentry-manager = false;
    homelab-manager = false;
    vm-manager = false;
    ai-workspace = true;
  };

  sudo = {
    requirePassword = true;
    timeout = 15;
  };
  enableFirewall = true;

  timeZone = "Europe/Berlin";
  locales = [ "en_US.UTF-8" ];
  keyboardLayout = "de";
  keyboardOptions = "eurosign";

  overrides = {
    enableSSH = true;
  };

  email = "example@example.com";
  domain = "example.com";
  certEmail = "example@example.com";

  # Draft host extras (not yet NCC options — document for migrate):
  #   hardware.nvidia-jetpack.enable = true;
  #   hardware.nvidia-jetpack.som = "orin-nano";
  #   hardware.nvidia-jetpack.carrierBoard = "devkit";
  #   hardware.nvidia-jetpack.super = true;
  #   hardware.nvidia-container-toolkit.enable = true;
  #   virtualisation.docker.enableNvidia = true;
  #   zramSwap / swapfile as on draft host
}
