{
  #
  # NVIDIA Jetson Orin Nano (aarch64) — host blueprint
  #
  # gpu = "jetson" sets systemConfig intent. Jetpack stays a *host flake extra*
  # (detected by ncc-check-flake-extras — not hardcoded into NCC flake.nix).
  #
  deviceTarget = {
    enable = true;
    label = "Jetson Orin Nano";
    description = "NVIDIA Jetson Orin Nano (aarch64 / jetpack host extras).";
    match = {
      arch = [ "aarch64" "arm64" ];
      filesAny = [ "/etc/nv_tegra_release" ];
      model = [ "orin" "jetson" ];
      compatible = [ "tegra" "orin" "jetson" ];
      textAny = [ "orin" "tegra" "jetson" "nvidia-jetpack" ];
    };
  };

  systemType = "server";
  hostName = "jetson-orin";
  system = {
    channel = "stable";
    platform = "aarch64-linux";
    bootloader = "systemd-boot";
  };

  packageModules = [
    "docker"
  ];

  users = {
    "fr4iser" = {
      role = "admin";
      defaultShell = "zsh";
      autoLogin = false;
    };
  };

  desktop = {
    enable = false;
  };

  hardware = {
    cpu = "none";
    gpu = "jetson";
    ram = {
      sizeGB = 8;
    };
    jetpack = {
      som = "orin-nano";
      carrierBoard = "devkit";
      super = true;
      containerToolkit = true;
      nvpmodelProfile = 1;
    };
  };

  allowUnfree = true;
  buildLogLevel = "minimal";

  features = {
    system-logger = false;
    system-checks = true;
    system-updater = true;
    ssh-manager = true;
    bootentry-manager = false;
    stack-manager = true;
    vm-manager = false;
    ai-workspace = true;
  };

  stackManager = {
    profiles = [ "compute-llm-arm" ];
    swarm = null;
  };

  sudo = {
    requirePassword = true;
    timeout = 15;
  };
  enableFirewall = true;

  timeZone = "Europe/Berlin";
  locales = [ "en_US.UTF-8" ];
  keyboardLayout = "de";
  keyboardOptions = "eurosign";

  overrides = {
    enableSSH = true;
  };

  email = "example@example.com";
  domain = "example.com";
  certEmail = "example@example.com";
}
