{
  "name": "domain.modules.enable",
  "description": "Enable an optional NCC module in systemConfig (no rebuild). Protected core modules cannot be toggled.",
  "risk": "write",
  "permission": "module.enable",
  "confirm": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Module name to enable"
      }
    },
    "required": ["name"]
  },
  "argv": ["ncc", "modules", "enable", "{{name}}"]
}
