{
  "name": "domain.modules.show",
  "description": "Show details for one NCC module by name.",
  "risk": "read",
  "permission": "module.read",
  "confirm": false,
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Module name (e.g. chronicle, ssh-client-manager)"
      }
    },
    "required": ["name"]
  },
  "argv": ["ncc", "modules", "show", "{{name}}"]
}
