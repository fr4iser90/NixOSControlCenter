{
  "id": "changelog-creator",
  "title": "Changelog creator",
  "category": "Rulebooks",
  "description": "CHANGELOG.md stub (Keep a Changelog style). One-shot.",
  "skill": null,
  "profile": "read-only",
  "mcp": ["git"],
  "requiresSecrets": [],
  "tier": "catalog",
  "scheduleKind": "once",
  "dryRun": true,
  "maxSteps": 12,
  "tags": ["rulebook", "docs", "once"],
  "goalTemplate": "Propose CHANGELOG.md (Keep a Changelog) for {{repositories}}. Style: {{style}}. Seed from recent git tags/commits if present. Diff-first dry-run. Output path: {{outputFile}}.",
  "params": [
    {"id": "style", "label": "Style", "type": "enum", "options": ["keep-a-changelog", "simple"], "default": "keep-a-changelog", "required": true},
    {"id": "outputFile", "label": "Output file", "type": "enum", "options": ["CHANGELOG.md", "docs/CHANGELOG.md"], "default": "CHANGELOG.md", "required": true},
    {"id": "repositories", "label": "Repositories", "type": "workspaceList", "required": false}
  ]
}
